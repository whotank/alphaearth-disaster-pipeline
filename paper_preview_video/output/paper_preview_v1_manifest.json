  "scenes": [
    {
      "caption": "Can one reusable representation describe different kinds of Earth-surface change?",
      "duration_s": 4.5,
      "key": "title"
    },
    {
      "caption": "AlphaEarth stores a 64-dimensional annual embedding for every 10-meter pixel. We compare years bracketing a hazard.",
      "duration_s": 7.0,
      "key": "annual-question"
    },
    {
      "caption": "We square the distance between pre- and post-event embeddings, then average that generic score within H3 cells.",
      "duration_s": 7.0,
      "key": "method"
    },
    {
      "caption": "For the Woolsey Fire, AlphaEarth change follows MTBS burn severity with a within-event Spearman correlation of 0.757.",
      "duration_s": 9.5,
      "key": "woolsey"
    },
    {
      "caption": "For the K\u012blauea eruption, the same unsupervised score follows the USGS lava map with a correlation of 0.774.",
      "duration_s": 9.5,
      "key": "kilauea"
    },
    {
      "caption": "The ten-fire cohort was frozen before AlphaEarth extraction. Nine associations were positive, with median rho 0.712.",
      "duration_s": 11.5,
      "key": "heldout-cohort"
    },
    {
      "caption": "But neither AlphaEarth nor TESSERA consistently beat the task-aligned optical comparator. Both confidence intervals cross zero.",
      "duration_s": 8.5,
      "key": "incremental-value"
    },
    {
      "caption": "Across eight development cases, all associations were positive, although strength varied across lava, forest loss, and drought.",
      "duration_s": 7.5,
      "key": "development-audit"
    },
    {
      "caption": "Annual embeddings provide a portable change representation, not a replacement for specialized indices or an operational detector.",
      "duration_s": 6.5,
      "key": "takeaway"
    }
  ],
